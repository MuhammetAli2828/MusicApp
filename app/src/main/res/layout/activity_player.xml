<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="10"
    android:background="@drawable/listebgr12"
    tools:context=".PlayerActivity">

    <!-- Back Button Top Left -->
    <ImageButton
        android:id="@+id/btnBackToList"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back to list"
        android:src="@drawable/icon_back" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="7"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtsn"
            android:layout_margin="20dp"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:padding="10dp"
            android:singleLine="true"
            android:text="Song Name"
            android:textColor="#FFF"
            android:textSize="22sp"
            android:textAlignment="center"
            android:textStyle="italic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/Imageview"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/kare1" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/txtsstart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:text="00:00"
                android:textColor="#FFF"
                android:textSize="16sp"
                android:gravity="center" />

            <SeekBar
                android:id="@+id/seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/txtsstop"
                android:layout_toEndOf="@id/txtsstart"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/txtsstop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:text="04:10"
                android:textColor="#FFF"
                android:textSize="16sp"
                android:gravity="center" />

        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <Button
                android:id="@+id/playbtn"
                android:layout_centerInParent="true"
                android:background="@drawable/ikonpause"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:contentDescription="play" />

            <Button
                android:id="@+id/btnnext"
                android:layout_toRightOf="@+id/playbtn"
                android:layout_centerVertical="true"
                android:background="@drawable/ikonskipnext"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:contentDescription="next song" />

            <Button
                android:id="@+id/btnback"
                android:layout_toLeftOf="@+id/playbtn"
                android:layout_centerVertical="true"
                android:background="@drawable/ikonskipback"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="previous song" />

            <Button
                android:id="@+id/btnforwardnext"
                android:layout_toRightOf="@+id/btnnext"
                android:layout_centerVertical="true"
                android:layout_marginLeft="8dp"
                android:background="@drawable/forwardskip"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="seek forward" />

            <Button
                android:id="@+id/btnforwardback"
                android:layout_toLeftOf="@+id/btnback"
                android:layout_centerVertical="true"
                android:layout_marginRight="8dp"
                android:background="@drawable/forwardback"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="seek backward" />

        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
